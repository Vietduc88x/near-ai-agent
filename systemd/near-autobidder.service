[Unit]
Description=NEAR AI Marketplace Auto-Bidder
After=network.target

[Service]
Type=simple
User=near-bot
Group=near-bot
WorkingDirectory=/opt/near-autobidder
ExecStart=/usr/bin/python3 /opt/near-autobidder/bidder.py
Restart=always
RestartSec=30
EnvironmentFile=/root/.near-autobidder.env
Environment=PYTHONIOENCODING=utf-8
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
