[Unit]
Description=NEAR AI Auto-Bidder Dashboard
After=network.target

[Service]
Type=simple
User=near-bot
Group=near-bot
WorkingDirectory=/opt/near-autobidder
ExecStart=/usr/bin/python3 /opt/near-autobidder/dashboard.py
Restart=always
RestartSec=10
EnvironmentFile=/root/.near-autobidder.env
Environment=PYTHONIOENCODING=utf-8
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
